# Настройки сервера для разработки. Скопируй в server/.env (в git не попадает).
# Переменные окружения важнее значений из этого файла.

# Адрес и порт HTTP. 127.0.0.1 — только с этого компьютера
# (эмулятор Android ходит сюда по адресу 10.0.2.2). По умолчанию 0.0.0.0:8080.
HOST=127.0.0.1
PORT=8080

# База из deploy/docker-compose.dev.yml
DATABASE_URL=postgres://milionchik:milionchik@127.0.0.1:5434/milionchik?sslmode=disable

# debug | info | warn | error
LOG_LEVEL=info

# Секрет подписи токенов, не короче 32 символов. Сгенерировать в PowerShell:
# $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
