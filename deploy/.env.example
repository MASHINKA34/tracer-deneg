# Настройки продакшена на VPS (этап 15). Скопируй в deploy/.env и заполни.
# deploy/.env в git не попадает.

# Домен, на который Caddy получит HTTPS-сертификат
DOMAIN=

# Пароль PostgreSQL (длинная случайная строка)
POSTGRES_PASSWORD=

# Секрет подписи токенов, не короче 32 символов (длинная случайная строка)
JWT_SECRET=

# Уровень логов сервера: debug | info | warn | error (по умолчанию info)
LOG_LEVEL=
