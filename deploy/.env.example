# Настройки продакшена для deploy/docker-compose.yml. Скопируй в deploy/.env и заполни.
# deploy/.env в git не попадает. Если DOMAIN, POSTGRES_PASSWORD или JWT_SECRET пустые,
# docker compose не запустится и назовёт переменную.
# Символ $ в значениях не используй: docker compose подставляет вместо него переменные.

# Домен, на который Caddy получит HTTPS-сертификат (A-запись домена указывает на сервер).
# Для проверки на своём компьютере — localhost (сертификат локального центра Caddy).
DOMAIN=

# Пароль PostgreSQL: только латинские буквы и цифры (он входит в DATABASE_URL сервера),
# не короче 32 символов. Сгенерировать: openssl rand -hex 32
# Образ postgres берёт пароль только при первом создании тома с данными: чтобы сменить
# его потом, нужно сменить пароль и в самой базе.
POSTGRES_PASSWORD=

# Секрет подписи токенов, не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Уровень логов сервера: debug | info | warn | error (пусто — info)
LOG_LEVEL=

# Страница /privacy: контакт для вопросов о данных (почта или Telegram) и оператор
# данных (имя или ник). Заполнить при деплое; пусто — на странице «не указан»
# и warn в логе сервера при старте.
PRIVACY_CONTACT=
PRIVACY_OPERATOR=
