  "fixed_sql": [
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"updated_at\" TEXT NOT NULL, \"updated_by\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"server_seq\" INTEGER NULL, \"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"emoji\" TEXT NOT NULL, \"owner_id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "budget_members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budget_members\" (\"budget_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"role\" TEXT NOT NULL, \"avatar_color\" TEXT NOT NULL, \"joined_at\" TEXT NOT NULL, \"left_at\" TEXT NULL, \"updated_at\" TEXT NULL, \"updated_by\" TEXT NULL, \"deleted_at\" TEXT NULL, \"server_seq\" INTEGER NULL, PRIMARY KEY (\"budget_id\", \"user_id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"updated_at\" TEXT NOT NULL, \"updated_by\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"server_seq\" INTEGER NULL, \"id\" TEXT NOT NULL, \"budget_id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"name_search\" TEXT NOT NULL, \"emoji\" TEXT NOT NULL, \"color\" TEXT NULL, \"sort_order\" INTEGER NOT NULL, \"is_system\" INTEGER NOT NULL CHECK (\"is_system\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"updated_at\" TEXT NOT NULL, \"updated_by\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"server_seq\" INTEGER NULL, \"id\" TEXT NOT NULL, \"budget_id\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL, \"amount_kopecks\" INTEGER NOT NULL, \"spent_on\" TEXT NOT NULL, \"comment\" TEXT NOT NULL, \"comment_search\" TEXT NOT NULL, \"author_id\" TEXT NOT NULL, \"recurring_id\" TEXT NULL, \"recurring_month\" TEXT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recurring_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_rules\" (\"updated_at\" TEXT NOT NULL, \"updated_by\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"server_seq\" INTEGER NULL, \"id\" TEXT NOT NULL, \"budget_id\" TEXT NOT NULL, \"category_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"amount_kopecks\" INTEGER NOT NULL, \"day_of_month\" INTEGER NOT NULL, \"start_month\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "member_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"member_profiles\" (\"user_id\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"avatar_color\" TEXT NOT NULL, \"birthday_month\" INTEGER NULL, \"birthday_day\" INTEGER NULL, PRIMARY KEY (\"user_id\"));"
        }
      ]
    },
    {
      "name": "outbox",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entity\" TEXT NOT NULL, \"entity_id\" TEXT NOT NULL, \"op\" TEXT NOT NULL, \"payload\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"not_before\" TEXT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT NULL);"
        }
      ]
    },
