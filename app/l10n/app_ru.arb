  "a11yShowPassword": "Показать пароль",
  "@a11yShowPassword": {
    "description": "TalkBack: «глазик» в поле пароля, пароль скрыт"
  },
  "a11yHidePassword": "Скрыть пароль",
  "@a11yHidePassword": {
    "description": "TalkBack: «глазик» в поле пароля, пароль виден"
  },
  "a11yClose": "Закрыть",
  "@a11yClose": {
    "description": "TalkBack: крестик (плашка праздника и т.п.)"
  },
  "a11yBackspace": "Стереть",
  "@a11yBackspace": {
    "description": "TalkBack: клавиша «стереть» на клавиатуре суммы"
  },
  "a11yAddExpense": "Добавить трату",
  "@a11yAddExpense": {
    "description": "TalkBack: кнопка «+» в нижнем меню"
  },
  "a11yPrevMonth": "Предыдущий месяц",
  "@a11yPrevMonth": {
    "description": "TalkBack: стрелка ‹ на карточке месяца"
  },
  "a11yNextMonth": "Следующий месяц",
  "@a11yNextMonth": {
    "description": "TalkBack: стрелка › на карточке месяца"
  },
  "a11yChooseMonth": "{month}, выбрать месяц",
