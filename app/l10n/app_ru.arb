      "date": { "type": "String", "example": "19 октября" },
      "rubles": { "type": "int", "format": "decimalPattern" }
    }
  },
  "a11yDayNoSpending": "{date}, трат нет",
  "@a11yDayNoSpending": {
    "description": "TalkBack: прошедший день без трат",
    "placeholders": {
      "date": { "type": "String", "example": "4 октября" }
    }
  },
  "a11yDayToday": "сегодня",
  "@a11yDayToday": {
    "description": "TalkBack: добавка к подписи ячейки сегодняшнего дня"
  },
  "a11yDaySelected": "выбран",
  "@a11yDaySelected": {
    "description": "TalkBack: добавка к подписи выбранной ячейки"
  },

  "navMonth": "Месяц",
  "@navMonth": { "description": "Нижнее меню: главная (карточка месяца)" },
  "navStats": "Статистика",
  "@navStats": { "description": "Нижнее меню: статистика" },
  "navRecurring": "Регулярные",
  "@navRecurring": { "description": "Нижнее меню: регулярные траты" },
  "navProfile": "Профиль",
  "@navProfile": { "description": "Нижнее меню: профиль" },

  "syncDone": "Синхронизировано",
  "@syncDone": { "description": "Статус синхронизации: всё на сервере" },
  "syncWaiting": "Ждёт сети · {count}",
  "@syncWaiting": {
    "description": "Статус синхронизации: нет сети, в очереди N изменений",
    "placeholders": {
      "count": { "type": "int", "format": "decimalPattern" }
    }
  },
  "syncSending": "Отправляем…",
  "@syncSending": { "description": "Статус синхронизации: идёт отправка" },
  "syncError": "Ошибка синхронизации",
  "@syncError": { "description": "Статус синхронизации: ошибка" },

  "monthAverage": "В среднем",
  "@monthAverage": { "description": "Футер карточки месяца: подпись среднего в день" },
  "monthAveragePerDay": "{amount} / день",
  "@monthAveragePerDay": {
    "description": "Футер карточки месяца: среднее в день",
    "placeholders": {
      "amount": { "type": "String", "example": "963 ₽" }
    }
  },
  "monthTotal": "Итог за месяц",
  "@monthTotal": { "description": "Футер карточки месяца: подпись итога" },

  "databaseErrorTitle": "Не удалось открыть траты",
  "@databaseErrorTitle": {
    "description": "Экран-заглушка при старте: локальная база на телефоне не открылась, заголовок"
  },
  "databaseErrorMessage": "Закройте «Милиончик» и откройте снова. Если ошибка повторится, напишите разработчику.",
  "@databaseErrorMessage": {
    "description": "Экран-заглушка при старте: локальная база не открылась, что делать"
  }
}
