    "description": "TalkBack: название месяца на карточке (открывает выбор месяца)",
    "placeholders": {
      "month": { "type": "String", "example": "Октябрь 2026" }
    }
  },
  "a11yDaySpent": "{date}, потрачено {rubles, plural, one{{rubles} рубль} few{{rubles} рубля} many{{rubles} рублей} other{{rubles} рубля}}",
  "@a11yDaySpent": {
    "description": "TalkBack: ячейка календаря с тратами («19 октября, потрачено 1 100 рублей»)",
