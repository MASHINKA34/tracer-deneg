<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card" />

    <LinearLayout
        android:id="@+id/widget_month_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_padding_start"
        android:paddingTop="@dimen/widget_padding_top"
        android:paddingEnd="@dimen/widget_padding_end"
        android:paddingBottom="@dimen/widget_padding_bottom"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitStart" />

                <ImageView
                    android:id="@+id/widget_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/widget_month_gap"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitStart" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_column_gap"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <ImageView
                android:id="@+id/widget_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/widget_total_gap"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_add"
            android:layout_width="@dimen/widget_add_size"
            android:layout_height="@dimen/widget_add_size"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/widget_add_gap">

            <ImageView
                android:id="@+id/widget_add_circle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_add_circle" />

            <ImageView
                android:id="@+id/widget_add_icon"
                android:layout_width="@dimen/widget_add_icon_size"
                android:layout_height="@dimen/widget_add_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_plus" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_sign_in_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/widget_padding_start"
        android:paddingTop="@dimen/widget_padding_top"
        android:paddingEnd="@dimen/widget_padding_end"
        android:paddingBottom="@dimen/widget_padding_bottom"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_sign_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
    </FrameLayout>
</FrameLayout>
